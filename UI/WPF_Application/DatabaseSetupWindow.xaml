<Window x:Class="WPF_Application.DatabaseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MySQL database setup (Ctrl+D to close)" Height="590" Width="500"
        MinHeight="560" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Background="#101923">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28">
                <TextBlock Text="Connect LankaJourney to MySQL" Foreground="#FFFFFF"
                           FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Margin="0,9,0,22" Foreground="#AAB1B9" FontSize="13"
                           TextWrapping="Wrap"
                           Text="Enter the MySQL account details for your LankaStay database. The password is encrypted for your Windows account." />

                <TextBlock Text="MySQL server" Foreground="#D9DEE3" Margin="0,0,0,6" />
                <TextBox x:Name="serverBox" Text="127.0.0.1" Padding="10" Margin="0,0,0,14" />

                <TextBlock Text="Port" Foreground="#D9DEE3" Margin="0,0,0,6" />
                <TextBox x:Name="portBox" Text="3306" Padding="10" Margin="0,0,0,14" />

                <TextBlock Text="Database" Foreground="#D9DEE3" Margin="0,0,0,6" />
                <TextBox x:Name="databaseBox" Text="LankaStay" Padding="10" Margin="0,0,0,14" />

                <TextBlock Text="MySQL username" Foreground="#D9DEE3" Margin="0,0,0,6" />
                <TextBox x:Name="usernameBox" Text="lankajourney_app" Padding="10" Margin="0,0,0,14" />

                <TextBlock Text="MySQL password" Foreground="#D9DEE3" Margin="0,0,0,6" />
                <PasswordBox x:Name="passwordBox" Padding="10" />

                <TextBlock x:Name="statusText" Margin="0,14,0,0" Foreground="#F5C66A"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="#0C151F" Padding="20,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Padding="14,8" Margin="0,0,10,0" />
                <Button x:Name="saveButton" Content="Test and save" IsDefault="True"
                        Padding="16,8" Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
